# MySQL connection for the `planner` database (airports, flight_schedule,
# data_status tables).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=planner
DB_USER=planner
DB_PASS=

# Authorizes POST /api/revalidate (app/api/revalidate/route.js), which the
# data pipeline (planner-data) calls after loading fresh data so the site
# drops its cache without a redeploy. Optional locally -- without it, that
# endpoint just always returns 401.
REVALIDATE_SECRET=
